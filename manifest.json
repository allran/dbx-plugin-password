{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.dbx.password",
  "name": "Password Manager",
  "version": "0.1.0",
  "publisher": "alan",
  "description": "Local password manager with groups.",
  "icon": "assets/plugin.svg",
  "engines": {
    "dbx": ">=0.5.68",
    "host_api": "1"
  },
  "permissions": [],
  "entrypoints": {
    "backend": {
      "protocol_versions": [1],
      "transport": "stdio-jsonl",
      "executable": "bin/dbx-plugin-password"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "workbench",
      "id": "io.dbx.password.workbench",
      "label": "Password Manager",
      "description": "Organize and fill local passwords by group.",
      "icon": "assets/plugin.svg"
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "密码管理",
      "description": "按分组管理本地密码条目。",
      "contributions": {
        "io.dbx.password.workbench": {
          "label": "密码管理",
          "description": "按分组浏览、创建与编辑本地密码。"
        }
      }
    }
  }
}
